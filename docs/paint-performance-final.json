  "command": "cargo bench -p gpui_ce_wgpu --no-default-features --features test-support --bench paint --offline -- 'paint_graph/(update|repeated_1000)|paint_canvas/(update_64|batched_64|chained_64)' --warm-up-time 1 --measurement-time 3 --sample-size 20",
  "snapshot": "Final private hot path: direct single update avoids patch allocation; Arc::make_mut copies only values once; retained drawing memo caches only value tables.",
